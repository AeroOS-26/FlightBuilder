# =============================================================================
# AeroOS Flight Builder — Environment Variables
# =============================================================================
# Local dev: copy to `.env.local` and fill in real values.
# Deploy (Vercel): set these in Project → Settings → Environment Variables.
#
# Only NEXT_PUBLIC_* vars reach the browser. Everything else is server-only and
# must NEVER use the NEXT_PUBLIC_ prefix — they hold secrets (Zoho zapikey,
# Freshworks API key) that must stay on the server.
#
#   REQUIRED = the app does not work without it.
#   OPTIONAL = has a safe built-in default; set only to override the default.
# =============================================================================


# ------------------------------------------------------------------ REQUIRED

# Zoho CRM function URL (with zapikey). The single Zoho write endpoint —
# handles flight creation, member joins, and the interest-lead write. The lead
# write reuses this URL unless ZOHO_LEAD_WRITE_URL is set. Server-only.
ZOHO_WEBHOOK_URL=

# Zoho CRM function URL (with zapikey) for the public share-page read
# (group_id -> public-safe flight view). Server-only.
ZOHO_PUBLIC_VIEW_URL=

# Public origin used to build share links. Must be the live domain
# (e.g. https://fly.perroair.com) — Zoho rejects localhost. Browser-exposed.
NEXT_PUBLIC_SHARE_BASE_URL=

# Freshworks (Freshsales) Contacts create endpoint. Server-only.
#   https://<instance>.myfreshworks.com/crm/sales/api/contacts
FRESHWORKS_WEBHOOK_URL=

# Freshworks API key — sent as `Authorization: Token token=<key>`. Server-only.
FRESHWORKS_API_KEY=


# ------------------------------------------------------------------ OPTIONAL
# (each line shows its default; uncomment only to override)

# Dedicated Zoho URL for the interest-lead write. Unset → the lead write reuses
# ZOHO_WEBHOOK_URL (the same function handles the lead event). Server-only.
# ZOHO_LEAD_WRITE_URL=

# Upstream timeout (ms) for Zoho calls, so a hung Zoho can't hang the request.
# ZOHO_TIMEOUT_MS=15000

# Upstream timeout (ms) for the Freshworks call. Caps the wait so a slow/hung
# Freshworks can never delay or block flight creation.
# FRESHWORKS_TIMEOUT_MS=15000

# Freshworks test switch. "true" marks each contact as a test record
# (last_name="TEST" + a synthetic external_id) so QA writes can be filtered and
# deleted — the Freshworks instance has no sandbox. Keep false/unset in prod.
# FRESHWORKS_TEST_MODE=false

# Brand theme id ("perro-air" | "jetlegs").
# NEXT_PUBLIC_BRAND=perro-air

# Internal API base path.
# NEXT_PUBLIC_API_BASE_URL=/api

# Client-side request timeout (ms).
# NEXT_PUBLIC_API_TIMEOUT_MS=15000

# --- Identity (Milestone 1) ---------------------------------------------------
# Identity is owned by the application; Zoho holds the CRM record, not the login.

# Postgres holding members, credentials and sessions. Server-only.
DATABASE_URL=postgresql://user:password@host:5432/aeroos
# Set to "true" for hosted Postgres that requires TLS.
DATABASE_SSL=false

# Signing secret for Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Transactional email (Postmark) ------------------------------------------
# Provider settled 19 Aug 2026. The three link flows (email verification, magic
# link, password reset) report "not configured" until these are set; no code
# change is needed once they are.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Perro Air <hello@perroair.com>"
POSTMARK_MESSAGE_STREAM=outbound

# Public origin used to build links inside those emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
