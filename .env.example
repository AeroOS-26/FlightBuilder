# AeroOS Flight Builder — environment configuration
# Copy to `.env.local` and fill in real values. Only NEXT_PUBLIC_-prefixed vars
# are exposed to the client by Next.js. Server-only secrets (e.g. the Zoho
# webhook key) must NOT use the NEXT_PUBLIC_ prefix.

# Base URL for the backend API (Zoho integration layer).
NEXT_PUBLIC_API_BASE_URL=/api

# Base URL used to construct generated share links (public app origin).
NEXT_PUBLIC_SHARE_BASE_URL=https://app.perroair.example

# Active brand id — drives the theme tokens. e.g. "perro-air" | "jetlegs".
NEXT_PUBLIC_BRAND=perro-air

# API request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# --- Server-only secrets (NEVER prefixed NEXT_PUBLIC_; not sent to the browser) ---

# Full Zoho CRM Function webhook URL, including the zapikey. Used only by the
# server-side relay (src/app/api/flight-group/route.ts) to forward the
# flight_group.created payload. Example:
#   https://www.zohoapis.com/crm/v7/functions/aeroos/actions/execute?auth_type=apikey&zapikey=YOUR_KEY
ZOHO_WEBHOOK_URL=AEROOS_ZOHO_WEBHOOK_URL

# Timeout (ms) for the upstream Zoho call from the relay.
ZOHO_TIMEOUT_MS=15000
